# ==========================================
# SHARED VALUES
# ==========================================
# Global Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------
# Security & Encryption Secrets
# ------------------------------------------
# To generate strong random secrets for the fields below, you can run this command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or using OpenSSL:
#   openssl rand -hex 32

# Used to authenticate internal requests from the Share Server to the Admin Server
INTERNAL_API_SECRET=your_super_secret_internal_key_here

# Used to cryptographically sign share image URLs so they can't be guessed or tampered with
SIGNED_URL_SECRET=dev-signed-secret

# Used to sign the JSON Web Tokens for operator login sessions
JWT_SECRET=dev-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret


# ==========================================
# OPERATOR PAGE (Admin Server)
# ==========================================
# Operator Login Credentials
OPERATOR_EMAIL=operator@snapsync.local
OPERATOR_PASSWORD=admin123

# The root URL for Vite (since it's at the root domain, use /)
VITE_BASE_URL=/

# Cookie Configuration for Admin Login
COOKIE_DOMAIN=operator.exmample.com
COOKIE_PATH=/
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# CORS configuration
ALLOWED_ORIGINS=https://operator.example.com


# ==========================================
# SHARE PAGE (Share Server)
# ==========================================
# The domain where the Share Page is hosted
SHARE_BASE_URL=https:/exmample.com/snapsync

# How the share server accesses the admin server for analytics
ADMIN_INTERNAL_URL=http://snapsync-server:3000

# The URL specifically for the frontend to construct share links
VITE_SHARE_BASE_URL=https://example.com/snapsync/share
