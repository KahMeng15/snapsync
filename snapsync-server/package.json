{
  "name": "snapsync-server",
  "version": "3.0.0",
  "private": true,
  "description": "Self-hosted photo booth system - Operator Hub",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "generate-icons": "node scripts/generate-icons.js",
    "start": "node dist/src/server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@snapsync/shared": "file:../shared",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.21.0",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.45",
    "vue-router": "^4.2.5",
    "vue-tsc": "^3.3.14",
    "vue3-toastify": "^0.2.9",
    "vuedraggable": "^2.24.3"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "brace-expansion": "^5.0.12",
    "file-stream-rotator": "^1.0.0",
    "minimatch": "^11.0.5",
    "source-map-js": "^1.2.2",
    "engine.io": "^6.6.11",
    "qs": "^6.17.1"
  }
